{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepL Client",
  "version": "0.1.3",
  "identifier": "dev.local.deepl-client",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepL Client",
        "width": 990,
        "height": 650,
        "minWidth": 760,
        "minHeight": 580,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "quick",
        "title": "Quick Assist",
        "url": "index.html?overlay=1",
        "width": 492,
        "height": 292,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 492,
        "minHeight": 292,
        "skipTaskbar": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "assets/icon.png",
      "assets/icon.ico"
    ]
  }
}
